			SpringHz = 10, -- [inferred] kick lasts ~1 frame, overshoot on the next
			SpringDamping = 0.19, -- [measured] forward overshoot: sight scale min 0.89 vs max 1.20
			BackStuds = 0.10, -- [measured] sight scale p90 1.17 / max 1.20 (0.019-0.022 m rearward at 30 fps)
			UpStuds = 0.044, -- [measured] sight dy sd 1.8 deg, max 6.3 deg
			SideStuds = 0.025, -- [measured] sight dx sd 1.1 deg
			PitchDeg = 5.0, -- [measured] barrel direction (reticle) jitter sd 1.5 deg, mean 0
			YawDeg = 4.5, -- [measured] reticle dx sd 1.3 deg, mean 0
			RollDeg = 5.0, -- [measured] sight tilt sd 1.7 deg
			FiringUpStuds = 0.0065, -- [measured] sight sits ~1.9 deg higher on average while firing (ADS), with the kicks
			HipScale = 1.0, -- [measured] hip silhouette kicks (scale up to 1.16-1.25) are similar in size
		},
	},

	Sway = {
		Regular = { CameraPitchP2P = 0, WeaponCentreP2P = 0.01 }, -- [measured] effectively still
		Stressed = { -- [measured] irregular, no clean rhythm
			CameraPitchP2P = 0.01, -- up to 0.02-0.04 over long spans
			CameraRollP2PDeg = 5.7, -- apparent
			WeaponCentreP2P = 0.07,
