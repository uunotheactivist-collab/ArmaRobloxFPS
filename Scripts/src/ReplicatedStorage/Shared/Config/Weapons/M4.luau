	HipFire = {
		Upright = 1.0, -- [measured] fraction of the idle cant removed while firing
		Pivot = "SightRear", -- [inferred] the sight stays roughly in place on screen
		AttackTime = 0.03, -- [observed] upright on the frame after the first shot
		ReleaseTau = 0.05, -- [observed] back to the canted idle 1-3 frames after the last shot
	},

	ADS = {
		InTime = 0.33, -- [measured] weapon main motion (frames 161-171)
		InSettleTime = 0.2, -- [measured] ease-out creep after the sight is in place
		OutTime = 0.12, -- [measured] frames 281-284
		ZoomMagnification = 1.16, -- [measured] +-0.02; tan(fovAds/2) = tan(fovHip/2) / 1.16
		ZoomInTime = 0.27, -- [measured] eased slow-fast-slow, starts 1 frame after the weapon
		ZoomDelay = 1 / 30, -- [measured] zoom starts one frame after the weapon moves (in and out)
		ZoomOutTime = 0.27, -- [uncertain +-2 frames] trails the weapon on exit
		CameraPitchOnEnter = 0, -- [measured] no camera move on ADS
		LeftArmVisible = true, -- [observed]
		SightCentreScreen = { U = 0.495, TopV = 0.415 }, -- [measured] sight centred, window top on the horizon
