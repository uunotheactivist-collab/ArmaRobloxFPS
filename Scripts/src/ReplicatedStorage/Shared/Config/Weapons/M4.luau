	DisplayName = "M4",
	Reference = "Reference/Weapons/M4/m4 animation.mp4",

	Viewmodel = {
		Data = "M4ViewmodelData", -- ReplicatedStorage.Shared.Assets.Weapons (generated by Blender/Scripts/17_m4_rig_export.py)
		HipFieldOfView = 70, -- [assumed] Roblox default; the footage only fixes the 1.16 ADS ratio. Poses were fitted at 70.
		ReloadAnimations = "M4ReloadAnimations", -- ReplicatedStorage.Shared.Assets.Weapons (generated by 23_m4_reload_export.py)
	},

	-- Firing: ReferenceAnalysis/M4/M4_Firing_Analysis.md (frames 1-45, 172-300, 400-445, 522-632).
	Fire = {
		Mode = "Auto", -- [observed] trigger held, continuous fire in every burst
		RPM = 770, -- [measured] ADS burst 198-268: 31 rounds / 2.333 s = 771 RPM; sight-kick spectrum 776 RPM;
		-- Stressed hip burst 538-607: 761 RPM (31 rounds). About +-25 RPM.
		MagazineSize = 30, -- [inferred] both main bursts end empty after 30 + 1 rounds, then an empty reload
		ChamberRound = true, -- [inferred] 30 in the magazine + 1 chambered (31-round bursts; HUD reads "MAG +1")
		SpareMagazines = 4, -- [placeholder] the footage never shows the loadout; reserve is magazine-based
		Range = 1500, -- studs [placeholder] the footage shows no targets or impacts
		Damage = 25, -- [placeholder] only so the foundation's test dummies can confirm server hits; no damage model yet
		HeadshotMultiplier = 2, -- [placeholder]
		SpreadDeg = 0, -- [not measurable] no tracers or impacts visible; shots go through the screen centre
		MaxOriginOffset = 8, -- studs between reported origin and head (server check, as the foundation)
		BurstAllowance = 3, -- shots that may arrive bunched together from network jitter (server check)
	},

	-- Ballistics (minimum slice; shared Server.Ballistics, ReferenceAnalysis/Ballistics/Ballistics_Analysis.md).
	Ballistics = {
		PenetrationStuds = 2.0, -- [placeholder] budget in studs of Penetrable material (bodies cost 0.25 / stud): a thin
