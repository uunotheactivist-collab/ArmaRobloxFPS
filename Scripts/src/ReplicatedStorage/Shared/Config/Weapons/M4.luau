		EmptyStressed = { Kind = "Empty", Clip = "EmptyStressed", Duration = 3.6, SwapAt = 1.6, ChamberAt = 2.7, DropOld = "IfEmpty", ReferenceFrames = { 624, 732 } }, -- [measured to 716 (video end); HUD "+2" at 672]
