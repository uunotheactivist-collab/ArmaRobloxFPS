			CameraPitchDeg = 1.0, -- short-span p-p ~0.7 deg plus slow drift (1.4-3 deg over long spans) [measured range]
			CameraRollDeg = 3.5, -- ~5 deg p-p [measured, apparent]; 2.5 gave 3.6 deg p-p in an 8 s playtest sample
			CameraYawDeg = 0.6, -- [uncertain] yaw is not measurable in the footage
			FastHz = 1.1, -- [inferred] motion decorrelates in ~11-20 frames
			SlowHz = 0.25,
			RollHz = 0.6,
			WeaponYawDeg = 2.5, -- viewmodel drift ~5 deg p-p on screen = ~7 % of width [measured]
			WeaponPitchDeg = 1.5,
			WeaponRollDeg = 2.0,
			WeaponShiftStuds = 0.02,
			WeaponHz = 0.9,
			AimReduction = 0.85, -- [inferred] Stressed ADS is never shown in the reference; keep the sight usable
			BlendTime = 0.6, -- s, Regular <-> Stressed ease [inferred]
		},
	},

	Muzzle = {
		FlashTime = 0.03, -- [observed] small yellow-white burst at the muzzle, ~1 frame at 30 fps
		FlashSizeStuds = 0.2, -- [measured approx] ~5 cm at the hip; seen as an orange glow at the window bottom in ADS
		LightTime = 0.03, -- [measured] ~30 % of ADS-burst frames are flash-lit at 12.9 shots/s
		LightColor = { 255, 165, 90 }, -- [observed] the sight's rear face turns tan/orange
		LightBrightness = 5, -- [inferred]
		LightRange = 12, -- studs [inferred] lights the sight, receiver, arm and the floor ahead
		LightOffset = { 0, -0.2, -0.45 }, -- studs, camera space [inferred] behind the sight: its rear face is lit
		Brass = {
			SpeedRight = 9, -- studs/s [inferred] casings leave the screen to the right within 1-2 frames (ADS)
			SpeedUp = 4, -- [observed] right / up-right
			SpeedBack = 1,
			SpinDegPerSec = 1800, -- [observed] spinning
			Gravity = 35, -- studs/s^2 (9.8 m/s^2)
			Lifetime = 0.5,
		},
		Tracers = false, -- [observed] none visible in any firing frame
		Impacts = false, -- [observed] none visible (no targets in the footage)
