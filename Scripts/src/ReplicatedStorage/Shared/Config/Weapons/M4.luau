			ShakeRollDeg = 0.6, -- [measured] roll sd 0.35-0.48 deg during bursts
			ShakeYawDeg = 0.5, -- [uncertain] yaw is not measurable while firing
			ShakeTau = 0.04, -- [inferred] s; mostly gone by the next 30 fps frame
		},
		-- Viewmodel recoil (presentation only): per shot a velocity kick into underdamped springs (between kicks the
		-- sight sits 3-11 % smaller than at rest = forward overshoot), plus a sustained offset while firing.
		Weapon = {
			-- Calibrated in Studio against the reference statistics with the focused test (Tests/M4_Firing): peak
