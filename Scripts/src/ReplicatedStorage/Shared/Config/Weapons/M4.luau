		TacticalStressed = { Kind = "Tactical", Clip = "TacticalStressed", Duration = 3.0667, SwapAt = 1.7333, DropOld = "Always", ReferenceFrames = { 434, 526 } }, -- [measured; dumped: HUD "+1" at 486 (inferred meaning)]
